{
  "name": "dsh-math-copy",
  "version": "0.1.1",
  "description": "把回答里的数学公式复制成可在 Obsidian / LaTeX 中重新渲染的 TeX：悬停公式出现三种格式的复制按钮，选中带公式的文本再 Ctrl+C 时公式会被还原成源码，而不是一堆字形。",
  "license": "MIT",
  "author": "lxj5820",
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tools",
    "cordis.patch.yml",
    "entry.js",
    "build-client.mjs",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SOH4C4759/dsh-math-copy.git"
  },
  "homepage": "https://github.com/SOH4C4759/dsh-math-copy#readme",
  "bugs": {
    "url": "https://github.com/SOH4C4759/dsh-math-copy/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "katex",
    "math",
    "latex",
    "obsidian",
    "clipboard"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
